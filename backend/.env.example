# Environnement
NODE_ENV=development  # "development" ou "production"

# Serveur
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173  # URL du frontend (pour CORS)

# URL de scan des cartes NFC (URL de base, sans le / final)
# Cette URL sera utilisée pour générer les liens de scan
# Format des URLs générées: {SCAN_BASE_URL}/{typedecarte}/{entreprise-type-subtype}/{token}
# Exemples:
#   Dev:  http://localhost:5173/restaurant/chez-marcel-restaurant-luxe/abc123
#   Prod: https://votre-domaine.com/restaurant/chez-marcel-restaurant-luxe/abc123
SCAN_BASE_URL=http://localhost:5173

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maze_nfc
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_db

# JWT (Sécurité - Génère une clé forte en production !)
JWT_SECRET=votre_cle_jwt_super_securisee_et_longue

# Cloudinary (Upload d'images)
# Créez un compte gratuit sur https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
